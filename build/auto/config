#!/bin/sh
# live-build configuration for Samurai Linux.
# Invoked by `lb build`, or directly with: bash auto/config
set -eu

# live-build recommends starting from a clean saved config. Keep our
# package-lists, hooks, and includes.chroot; remove only generated state.
rm -rf config/binary config/bootstrap config/chroot config/common config/source

lb config noauto \
    --distribution trixie \
    --architecture amd64 \
    --binary-image iso-hybrid \
    --archive-areas "main contrib non-free-firmware" \
    --debian-installer none \
    --firmware-chroot true \
    --bootappend-live "boot=live components username=samurai hostname=samurai quiet splash console=tty0 console=ttyS0,115200n8 systemd.show_status=1" \
    --iso-application "Samurai Linux" \
    --iso-publisher "Samurai Linux Project" \
    --iso-volume "SAMURAI_LINUX" \
    --apt-indices false \
    --mirror-bootstrap "http://deb.debian.org/debian/" \
    --mirror-chroot "http://deb.debian.org/debian/" \
    --mirror-binary "http://deb.debian.org/debian/"
