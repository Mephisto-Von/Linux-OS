kde-standard
sddm
kde-config-sddm
plasma-desktop
plasma-workspace
plasma-nm
plasma-pa
plasma-browser-integration
konsole
dolphin
ark
kate
gwenview
okular
kde-spectacle
xserver-xorg
xwayland
pipewire
pipewire-pulse
wireplumber
alsa-utils
xdg-user-dirs
xdg-utils
bluedevil
firefox-esr
fonts-noto-cjk
fonts-noto-color-emoji
fonts-dejavu

# Installer (Calamares running from the live session)
calamares
calamares-settings-debian
grub-common
grub2-common
grub-pc-bin
grub-efi-amd64-bin
efibootmgr
dosfstools
mtools
# unpackfs shells out to unsquashfs; do not rely on a recommends here.
squashfs-tools
# Filesystem tools for the optional manual-partitioning choices.
btrfs-progs
xfsprogs
f2fs-tools
ntfs-3g
os-prober
x11-xserver-utils

# Live system (required for a bootable live image)
live-boot
live-config
live-config-systemd
live-tools
user-setup
initramfs-tools
linux-image-amd64

# System and developer basics
pciutils
libsecret-tools
ca-certificates
curl
wget
git
sudo
vim
python3
python3-venv
build-essential
cmake
ninja-build
nftables
apparmor
